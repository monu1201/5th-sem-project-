# ====================================================================
# Environment Configuration
# AI-Powered Intelligent Code Review and Software Defect Prediction System
# ====================================================================

# Database Configuration (MySQL Primary; SQLite will auto-fallback if MySQL is offline)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/code_review_db
# For zero-config local SQLite: DATABASE_URL=sqlite:///./app.db

# AI Engine Provider Configuration
# Supported providers: openai (ChatGPT) | gemini | anthropic | ollama | none (offline rule-based)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_chatgpt_api_key_here
AI_API_KEY=your_optional_fallback_api_key_here
AI_MODEL=gpt-4o-mini

# Optional base URLs for OpenAI-compatible or local models
# AI_BASE_URL=https://api.openai.com/v1/chat/completions
# OLLAMA_BASE_URL=http://localhost:11434

# Application Server Port & Host
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
